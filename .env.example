# Browser-safe Supabase settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_COMMUNICATIONIQ_ROOFTOP_ID=225b13ce-0ed8-49e4-937d-0e5198ca0e01

# Server-only. Required by /api/auth/request-code to keep the invite-only lookup private.
# Never expose this as NEXT_PUBLIC_* and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Server-to-server secret for the Gmail Apps Script ingestion bridge and AI assessment trigger.
# Generate a long random value and set the SAME value in the Apps Script property
# COMMSIQ_INGEST_SECRET. Never expose this as NEXT_PUBLIC_*.
COMMSIQ_INGEST_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# Server-only OpenAI settings for CommunicationIQ assessment generation.
OPENAI_API_KEY=REPLACE_WITH_SERVER_ONLY_OPENAI_API_KEY
# Cost-sensitive default; may be overridden without code changes.
COMMUNICATIONIQ_AI_MODEL=gpt-5.6-luna
